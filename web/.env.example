# =====================================================================
# nik volt — environment variables
# Copy this file to .env.local for local dev (NEVER commit .env.local).
# Add the same vars in Vercel: Project → Settings → Environment Variables.
# =====================================================================

# --- Supabase (from Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # SECRET — server only, never expose

# --- hCaptcha (from hcaptcha.com → site settings) ---
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET_KEY=0x...               # SECRET — server only

# --- Resend (from resend.com → API Keys) ---
RESEND_API_KEY=re_...                   # SECRET — server only
RESEND_FROM=nik volt <notifications@nikvolt.com>
NOTIFY_TO=kontakt@nikvolt.com

# --- Misc ---
IP_HASH_SALT=<any-random-string>        # changes only matter if you query by ip_hash
